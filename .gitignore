# Python
__pycache__/
*.py[cod]
.venv/
backend/.venv/
*.egg-info/

# PyInstaller (KAN-46: standalone `kan` binary build outputs)
pandan-cli/build/
pandan-cli/dist/
pandan-cli/*.spec
# Generated at package time by pandan-cli/packaging/stamp_build.py so the frozen
# binary's --version reports the commit it was built from (V50, KAN-435).
# Committing it would make a source checkout claim to be a release.
pandan-cli/pandan_cli/_build_stamp.py

# Docs site (Zensical build output — regenerated by CI, never committed)
/site/

# Node / Vite
node_modules/
frontend/dist/
frontend/.vite/

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# Env
.env
*.local

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local MCP config — holds a personal access token (never commit)
.mcp.json

# Claude Code local state — personal settings + transient agent worktree
# checkouts (isolation: "worktree"). Machine-local, not shareable; never commit.
.claude/
