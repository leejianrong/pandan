#!/usr/bin/env bash
# Fast local gate before pushing. Mirrors the CI lint / unit / frontend / client /
# mcp / cli jobs so a push never lands red on GitHub. Integration tests need a
# Docker daemon, so they stay CI-only (run them yourself with
# `uv run pytest tests/integration`).
#
# THIS FILE HAS TESTS: `mcp/tests/test_prepush_hook.py` (KAN-484). CI runs them for
# any change under `scripts/git-hooks/**` via the `mcp` paths filter, so edit the
# hook and the tests together. They drive this script against throwaway repos in
# `tmp_path` with fabricated stdin; point `PREPUSH_HOOK` at another copy to test a
# mutated or historical version without checking it out (switching branches would
# swap the hook itself).
#
# Path-scoped (KAN-36): only the checks for areas touched by the commits being
# pushed run. A backend/mcp/client-only worktree (no frontend toolchain) no longer
# fails on svelte-check for a change that never touched frontend/, so scoped slices
# get real signal instead of a blanket `--no-verify`.
#
# Two diff ranges, not one (KAN-484): which checks to RUN is a question about the
# push (incremental), while the CLI version-bump POLICY is a question about the
# branch (merge-base vs the default branch, matching CI). See the long note at the
# range computation below — that split is the whole point and not incidental.
#
# Hostile-environment behaviour (KAN-523): this is the one guard that runs on a
# machine nobody controls the config of — worktrees, treehouse pool trees, agent
# sandboxes, shallow CI clones — and linked worktrees SHARE .git/config, so one
# stray value reaches the whole clone. So: no work tree → skip loudly rather than
# block every push, and any degraded baseline announces itself on stderr.
#
# Install (from repo root):
#   ln -sf ../../scripts/git-hooks/pre-push .git/hooks/pre-push
# Bypass for a one-off (use sparingly):  git push --no-verify
set -euo pipefail

# Resolve the work tree WITHOUT letting `set -e` kill the hook first (KAN-523).
# `git rev-parse --show-toplevel` exits 128 with `fatal: this operation must be
# run in a work tree` when there is no work tree — a genuinely bare repo, or (the
# case that actually bit us) a normal checkout whose `core.bare` got set to true
# by accident. As a bare `repo_root="$(…)"` under `set -e` that aborted the hook
# before it printed a single word, so every push in the affected clone died with
# a naked git fatal naming neither the hook nor the cause.
#
# SKIP, don't fail. Deliberate, and the reasoning matters because a silent skip
# is the KAN-484 / KAN-505 "confidently wrong output" family this hook is trying
# to stay out of:
#   * The hook genuinely CANNOT do its job here — there is no work tree to lint,
#     no package dirs to cd into. Blocking the push buys no correctness, only
#     unavailability.
#   * CI is the enforcing gate for everything this hook mirrors, and `main` is
#     protected, so a skipped hook cannot let anything reach main unevaluated.
#     This hook's value is latency, not authority.
#   * The only escape from a hard fail would be `--no-verify`, which is exactly
#     the habit KAN-484 records as fatal to a guard's credibility — and unlike a
#     real guard failure there is nothing in the user's CHANGE to fix.
#   * The defect was never the exit code; it was the silence about WHY. A skip
#     that names the cause on stderr is the opposite of that family.
if ! repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || [ -z "$repo_root" ]; then
  echo "pre-push ▸ SKIPPED: git reports no work tree, so this hook cannot run." >&2
  echo "         Likely cause: the repository is bare, or core.bare is true on a" >&2
  echo "         checkout that DOES have a work tree (check: git config --get core.bare)." >&2
  echo "         Note linked worktrees SHARE the main repository's .git/config, so a" >&2
  echo "         stray value set from any one worktree reaches every checkout of the clone." >&2
  echo "         Allowing the push — CI is the enforcing gate and main is protected." >&2
  exit 0
fi

zero="0000000000000000000000000000000000000000"

# Resolve a stable base ref for new branches / stdin-less fallbacks. Track
# whether it resolved at all: an unresolvable base and a branch that simply adds
# nothing beyond the base both yield an empty branch range, and they need
# opposite treatment (KAN-484 — see the fail-safe note below).
#
# THREE candidates, not one (KAN-523), and each non-default one announces itself:
#   1. `origin/main` — what CI actually diffs a PR against in this repo.
#   2. `refs/remotes/origin/HEAD` — origin's own idea of its default branch, set
#      by `git clone` and repairable with `git remote set-head origin -a`. This is
#      the fork / renamed-default case (`master`, `develop`), where neither
#      `origin/main` nor a local `main` exists and the old code went straight to
#      unresolvable — silently policing the narrower push range instead.
#   3. a local `main` — a clone that has never fetched.
# Using anything but (1) means the hook is evaluating a DIFFERENT baseline than
# CI will. That is still fail-safe (a stale or wider base only widens the branch
# range; it never hides a missing bump), but an unannounced baseline swap is the
# same confidently-wrong-output family as KAN-484/KAN-505 — so say which one.
base_resolved=1
if git rev-parse --verify -q origin/main >/dev/null; then
  base_ref="origin/main"
elif origin_head="$(git symbolic-ref --short -q refs/remotes/origin/HEAD)" &&
  [ -n "$origin_head" ] &&
  git rev-parse --verify -q "$origin_head" >/dev/null; then
  base_ref="$origin_head"
  echo "pre-push ▸ NOTE: no origin/main — using $base_ref (origin's default branch) as the" >&2
  echo "         branch baseline for policy checks. CI diffs against the PR base instead." >&2
elif git rev-parse --verify -q main >/dev/null; then
  base_ref="main"
  echo "pre-push ▸ NOTE: no origin/main — using the LOCAL main as the branch baseline, which" >&2
  echo "         may be stale. Run \`git fetch origin\` for the baseline CI actually uses." >&2
else
  base_ref="main"
  base_resolved=0
fi

# Compute the set of files changed by the push. A pre-push hook gets
# `<local-ref> <local-sha> <remote-ref> <remote-sha>` lines on stdin.
#
# TWO ranges, deliberately (KAN-484). They exist because this hook answers two
# different questions and only one of them is about the push:
#
#   `changed`         TEST SELECTION — "what changed since the last push?"
#                     Incremental (remote tip → local tip) once the branch is on
#                     the remote. On a long-lived branch that is much smaller than
#                     the whole-branch diff, and re-running ruff / pytest /
#                     svelte-check over areas an earlier push already proved green
#                     is wasted wall-clock on every single push.
#
#   `branch_changed`  POLICY — "does this BRANCH bump the CLI version?"
#                     Always the whole branch (merge-base against the default
#                     branch), which is exactly what CI's `CLI version bump` step
#                     evaluates (dorny/paths-filter against the PR base).
#
# They MUST differ, and conflating them was the KAN-484 bug: evaluated over the
# incremental range the version-bump policy false-positives on a merge commit.
# Merging main into an in-flight branch — the normal move under this repo's branch
# protection whenever another PR lands first, and what `gh pr update-branch` does
# — puts main's pandan_cli/ files inside `remote_sha..local_sha`, while the bump
# you already made sits in an earlier push and is OUTSIDE it. Worse, resolving the
# version-line conflict the *correct* way (keep your branch's already-higher
# version) leaves the version files byte-identical on both ends of the incremental
# range, so they vanish from the diff entirely. Real case: commit 608e2f3, where
# `git diff 1afa1cc 608e2f3` lists pandan_cli/{cli,context}.py and no version file
# at all, while the branch range lists both plus __init__.py and pyproject.toml.
# The hook fired; CI passed; the agent pushed with --no-verify. A guard that cries
# wolf gets routed around, and then it is not a guard — so the fix is to make the
# policy ask the branch-shaped question. NOT to add a waiver flag: V50 shipped
# without one on purpose (KAN-435), and that stands.
changed=""
branch_changed=""
have_stdin=0
while read -r local_ref local_sha remote_ref remote_sha; do
  have_stdin=1
  # Branch deletion (nothing to push) — skip.
  [ "$local_sha" = "$zero" ] && continue

  # Whole-branch range: diff against the base (merge-base if reachable). Stale
  # `origin/main` only widens this — it never hides a missing bump — because
  # anything main landed under pandan_cli/ came with its own version bump.
  range_base="$base_ref"
  if mb="$(git merge-base "$base_ref" "$local_sha" 2>/dev/null)"; then
    range_base="$mb"
  fi
  branch_files="$(git diff --name-only "$range_base" "$local_sha" 2>/dev/null || true)"

  if [ "$remote_sha" = "$zero" ]; then
    # New branch on the remote: there is no previous push, so the whole-branch
    # range is also the only sensible test range.
    files="$branch_files"
  else
    files="$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)"
  fi
  changed="$changed
$files"
  branch_changed="$branch_changed
$branch_files"
done

if [ "$have_stdin" -eq 0 ]; then
  # No stdin (e.g. invoked by hand): fall back to upstream, else the base ref.
  if changed="$(git diff --name-only '@{upstream}...HEAD' 2>/dev/null)"; then
    :
  else
    changed="$(git diff --name-only "$base_ref...HEAD" 2>/dev/null || true)"
  fi
  # `A...B` is already merge-base semantics, so this is the branch range.
  branch_changed="$(git diff --name-only "$base_ref...HEAD" 2>/dev/null || true)"
fi

# Normalise both to a sorted, de-duped, non-empty list.
changed="$(printf '%s\n' "$changed" | sed '/^$/d' | sort -u)"
branch_changed="$(printf '%s\n' "$branch_changed" | sed '/^$/d' | sort -u)"

# Fail safe, not open: in a clone with neither `origin/main` nor `main` the branch
# range comes back empty, which would silently skip the policy. Fall back to the
# incremental set so it is still evaluated on *something*.
#
# Gated on `base_resolved` on purpose. An empty branch range with a *resolvable*
# base means something different — the tip is already an ancestor of the base, so
# the branch adds nothing to police, and CI would compute the same empty diff and
# skip its step too. Falling back there would re-open exactly the KAN-484 bug in
# that corner, so don't.
#
# And SAY SO when it happens (KAN-523). The fallback is correct; the silence was
# the defect. A degraded baseline that announces nothing is how the version-bump
# guard ends up quietly evaluating the weaker range with no signal at all — the
# same confidently-wrong-output family as KAN-484 and KAN-505.
if [ "$base_resolved" -eq 0 ] && [ -z "$branch_changed" ]; then
  branch_changed="$changed"
  echo "pre-push ▸ NOTE: no branch baseline — neither origin/main, origin's default HEAD, nor" >&2
  echo "         a local main resolves (shallow/partial clone, never-fetched worktree, or a" >&2
  echo "         differently-named default). Policy checks fall back to THIS PUSH's range," >&2
  echo "         which is NARROWER than what CI evaluates. Fix with \`git fetch origin\`" >&2
  echo "         (or \`git remote set-head origin -a\`)." >&2
fi

if [ -z "$changed" ] && [ -z "$branch_changed" ]; then
  echo "pre-push ▸ no changed files detected — nothing to check"
  echo "pre-push ▸ OK"
  exit 0
fi

# Does the changed set contain a path under the given prefix? `touched` asks the
# incremental (test-selection) set, `branch_touched` the whole branch — see the
# two-ranges note above before swapping one for the other.
touched() { printf '%s\n' "$changed" | grep -q "^$1"; }
branch_touched() { printf '%s\n' "$branch_changed" | grep -q "^$1"; }

ran_any=0

if touched "backend/"; then
  ran_any=1
  echo "pre-push ▸ backend: ruff + unit tests"
  ( cd "$repo_root/backend" && uv run ruff check . && uv run pytest tests/unit -q )
  # Integration tests themselves need Docker (CI-only), but *collecting* them does
  # not — and collection fires a guard (tests/integration/conftest.py
  # pytest_collection_finish) that catches app modules imported at top level, which
  # would otherwise bind the DB engines to the wrong URL and pass locally / fail CI
  # (the PR #17 trap). This is a fast, Docker-free import-hygiene check.
  echo "pre-push ▸ backend: integration import hygiene (collect-only, no Docker)"
  ( cd "$repo_root/backend" && uv run pytest tests/integration --collect-only -q >/dev/null )
else
  echo "pre-push ▸ backend: skipped (no backend/ changes)"
fi

if touched "frontend/"; then
  ran_any=1
  echo "pre-push ▸ frontend: svelte-check"
  ( cd "$repo_root/frontend" && npm run check )
else
  echo "pre-push ▸ frontend: skipped (no frontend/ changes)"
fi

if touched "mcp/"; then
  ran_any=1
  echo "pre-push ▸ mcp: ruff + tests"
  ( cd "$repo_root/mcp" && uv run ruff check . && uv run pytest -q )
else
  echo "pre-push ▸ mcp: skipped (no mcp/ changes)"
fi

if touched "pandan-client/"; then
  ran_any=1
  echo "pre-push ▸ pandan-client: ruff + tests"
  ( cd "$repo_root/pandan-client" && uv run ruff check . && uv run pytest -q )
else
  echo "pre-push ▸ pandan-client: skipped (no pandan-client/ changes)"
fi

if touched "pandan-cli/"; then
  ran_any=1
  echo "pre-push ▸ pandan-cli: ruff + tests"
  ( cd "$repo_root/pandan-cli" && uv run ruff check . && uv run pytest -q )
else
  echo "pre-push ▸ pandan-cli: skipped (no pandan-cli/ changes)"
fi

# Bump-on-fix (V50 / KAN-435): a CLI change users can SEE must ship a version bump
# in the same CHANGE, or `--version` can't tell a stale install from current source
# — the root cause of two false bug reports. Cheap rule: any diff under
# pandan-cli/pandan_cli/ must also touch a version declaration. A comment-only edit
# taking a patch bump is a fine, honest outcome; CI enforces the same rule (the
# `CLI version bump` step), this is just the fast local signal.
#
# Asks `branch_touched`, not `touched` — the question is about the branch, not the
# push (KAN-484; see the two-ranges note at the top). Its own block rather than
# nested inside the pandan-cli test block for the same reason: a push whose
# incremental diff is docs-only still gets its branch checked, which is what CI
# does — CI gates this step on `cli_code` alone, independently of the CLI job's own
# `cli` gate.
if branch_touched "pandan-cli/pandan_cli/"; then
  if branch_touched "pandan-cli/pyproject.toml" || branch_touched "pandan-cli/pandan_cli/__init__.py"; then
    echo "pre-push ▸ pandan-cli: version bump present in this branch"
  else
    echo "pre-push ▸ FAIL: pandan-cli/pandan_cli/ changed in this branch but the version did not."
    echo "         Bump __version__ in pandan-cli/pandan_cli/__init__.py AND version in"
    echo "         pandan-cli/pyproject.toml (then re-run \`uv lock\`) in this same change."
    echo "         Why: a user-visible fix that never bumps the version ships a binary"
    echo "         indistinguishable from source (V50, KAN-435)."
    echo "         Scope: the whole branch vs $base_ref, matching CI — so an earlier"
    echo "         push's bump counts. If $base_ref looks stale, \`git fetch origin\`."
    exit 1
  fi
fi

if [ "$ran_any" -eq 0 ]; then
  echo "pre-push ▸ only non-package files changed (docs / .github / .claude / root) — no package checks needed"
fi

echo "pre-push ▸ OK"
